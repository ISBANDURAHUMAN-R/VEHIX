# ==============================
# VEHIX .gitignore
# ==============================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments & Configuration
.env
.venv*

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.metadata.json
*~

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Backend uploads and temporary results (keep folder structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/results/*
!backend/results/.gitkeep
